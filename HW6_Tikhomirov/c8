#!/bin/bash
# Exit status of 'read':
#   0  — user typed something or just enter
#   1  — EOF
# In both cases where name is empty we fall back to "tmpuser?"

read -p "Enter your name: " name   # -p prints prompt without trailing \n

if [ -n "$name" ]; then
    echo "Hello, $name!"
else
    # covers: empty Enter OR Ctrl+D (EOF, no Enter pressed)
    echo "Hello, tmpuser?"
fi
